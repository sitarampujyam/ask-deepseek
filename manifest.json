{
  "manifest_version": 3,
  "name": "Ask DeepSeek",
  "version": "1.0.0",
  "description": "Read PDFs in a glass reader and highlight text on any page to drop it into the DeepSeek chat in the side panel. Nothing is sent automatically.",
  "minimum_chrome_version": "114",
  "permissions": [
    "sidePanel",
    "declarativeNetRequest",
    "storage",
    "contextMenus",
    "webNavigation",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Ask DeepSeek",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "selectors.js",
        "content.js",
        "page-button.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    },
    {
      "matches": [
        "http://*/*",
        "https://*/*",
        "file:///*"
      ],
      "exclude_matches": [
        "https://chat.deepseek.com/*"
      ],
      "js": [
        "page-button.js"
      ],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "open-panel": {
      "suggested_key": {
        "default": "Alt+Shift+D",
        "mac": "Alt+D"
      },
      "description": "Open or close the DeepSeek side panel"
    }
  }
}